<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentScope.Client.ViewModels"
             x:Class="AgentScope.Client.Views.McpListView"
             x:DataType="vm:McpListViewModel">
  <DockPanel Margin="16">
    <TextBlock Text="MCP 服务管理" FontSize="22" FontWeight="Bold"
               DockPanel.Dock="Top" Margin="0,0,0,16" />

    <Grid ColumnDefinitions="300,*" DockPanel.Dock="Top">
      <!-- 左侧列表 -->
      <Border Grid.Column="0" Margin="0,0,16,0">
        <DockPanel>
          <Button Content="新增 MCP" Command="{Binding NewItemCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,4" />
          <Button Content="编辑" Command="{Binding EditItemCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,4" />
          <Button Content="删除" Command="{Binding DeleteItemCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,8" />

          <ListBox ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding TransportType}" FontSize="11"
                               Foreground="#888" />
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                               Foreground="{Binding ConnectionStatus,
                                  Converter={x:Null}}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右侧编辑区 -->
      <Border Grid.Column="1"
              IsVisible="{Binding IsEditing}"
              Background="#F9F9F9"
              CornerRadius="8"
              Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Text="名称" />
            <TextBox Text="{Binding EditName}" />

            <TextBlock Text="传输协议" />
            <ComboBox ItemsSource="{Binding TransportTypes}"
                      SelectedItem="{Binding EditTransportType}" />

            <TextBlock Text="命令（stdio）" />
            <TextBox Text="{Binding EditCommand}"
                     Watermark="如 npx @modelcontextprotocol/server-filesystem" />

            <TextBlock Text="参数（stdio，空格分隔）" />
            <TextBox Text="{Binding EditArgs}" />

            <TextBlock Text="URL（sse/http）" />
            <TextBox Text="{Binding EditUrl}"
                     Watermark="如 http://localhost:8080/mcp" />

            <TextBlock Text="API Key（可选）" />
            <TextBox Text="{Binding EditApiKey}" PasswordChar="*" />

            <TextBlock Text="工作目录（可选）" />
            <TextBox Text="{Binding EditWorkingDirectory}" />

            <CheckBox Content="启用" IsChecked="{Binding EditIsEnabled}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="保存" Command="{Binding SaveItemCommand}"
                      Background="#7C3AED" Foreground="White" />
              <Button Content="取消" Command="{Binding CancelEditCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
