<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AgentScope.Client.ViewModels"
             x:Class="AgentScope.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel Margin="16">
    <TextBlock Text="LLM 模型配置" FontSize="22" FontWeight="Bold"
               DockPanel.Dock="Top" Margin="0,0,0,16" />

    <Grid ColumnDefinitions="300,*" DockPanel.Dock="Top">
      <!-- 左侧列表 -->
      <Border Grid.Column="0" Margin="0,0,16,0">
        <DockPanel>
          <Button Content="新增" Command="{Binding NewLlmCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,8" />
          <Button Content="编辑" Command="{Binding EditLlmCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,4" />
          <Button Content="设为默认" Command="{Binding SetDefaultCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,4" />
          <Button Content="删除" Command="{Binding DeleteLlmCommand}"
                  DockPanel.Dock="Top" Margin="0,0,0,8" />

          <ListBox ItemsSource="{Binding LlmConfigs}"
                   SelectedItem="{Binding SelectedLlm}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Provider}" FontSize="11" Foreground="#888" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 右侧编辑区 -->
      <Border Grid.Column="1"
              IsVisible="{Binding IsEditing}"
              Background="#F9F9F9"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="名称" />
          <TextBox Text="{Binding EditName}" />

          <TextBlock Text="Provider" />
          <ComboBox ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding EditProvider}" />

          <TextBlock Text="模型名称" />
          <TextBox Text="{Binding EditModelName}" />

          <TextBlock Text="API Key" />
          <TextBox Text="{Binding EditApiKey}" PasswordChar="*" />

          <TextBlock Text="Base URL (可选)" />
          <TextBox Text="{Binding EditBaseUrl}" />

          <TextBlock Text="Temperature" />
          <TextBox Text="{Binding EditTemperature}" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="保存" Command="{Binding SaveLlmCommand}"
                    Background="#7C3AED" Foreground="White" />
            <Button Content="取消" Command="{Binding CancelEditCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
