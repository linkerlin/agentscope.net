<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uno Platform WinUI Packages -->
    <PackageReference Include="Uno.WinUI" Version="6.6.184" />
    <PackageReference Include="Uno.WinUI.RemoteControl" Version="5.6.99" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="Uno.UI.Adapter.Microsoft.Extensions.Logging" Version="6.6.184" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    
    <!-- Uno Platform Desktop Support -->
    <PackageReference Include="Uno.WinUI.Skia.Gtk" Version="5.6.99" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentScope.Core\AgentScope.Core.csproj" />
  </ItemGroup>

  <!-- 
    显式定义 XAML 文件项，确保 Uno 源生成器能正确处理它们。
    net10.0 下 SDK 不会自动将 .xaml 文件识别为 Page/ApplicationDefinition。
  -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" SubType="Designer" />
    <Page Include="MainWindow.xaml" SubType="Designer" />
  </ItemGroup>

</Project>
